# Program to print duplicate characters in a string
text = input("Enter a string: ")

printed = ""

print("Duplicate characters are:")

for ch in text:
    if text.count(ch) > 1 and ch not in printed:
        print(ch)
        printed += ch

#Display the frequency of every character in a string. 
# Program to display the frequency of every character

text = input("Enter a string: ")

printed = ""

for ch in text:
    if ch not in printed:
        print(ch, "=", text.count(ch))
        printed += ch

#Check whether two strings are anagrams. 
text = input("Enter a string: ")
text1 = input("Enter another string: ")
if sorted(text)==sorted(text1):
    print(text, "and",text1 ,"are anagrams")
else:
    print(text, "and",text1 ,"are not an anagram")

#Remove duplicate characters while maintaining the original order. 
s = input("Enter a string: ")

result = ""

for ch in s:
    if ch not in result:
        result += ch

print("String after removing duplicates:", result)

#Check whether a given substring exists in the main string. 
text=input("Enter a string :")
stext=input("Enter a substring to find :")
